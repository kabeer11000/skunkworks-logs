<!-- Navigation -->
<div>
    <style>
        md-list {
            --md-list-container-color: transparent;
        }
    </style>
    <div class="min-h-screen">
        <md-list class="w-60">
            <md-list-item href="/">
                <img src="/logo/skunkworks-transparent.png" class="w-16 h-16" />
            </md-list-item>
            <!-- Material 3 Subheader -->
            <div class="flex justify-between items-center">
                <div
                    class="px-4 pt-5 pb-2 text-sm font-medium text-neutral-600 dark:text-neutral-400"
                >
                    Drains
                </div>
                <div>
                    <md-fab
                        label="Create Drain"
                        variant="primary"
                        class="flex justify-between items-center"
                        onclick="window.dispatchEvent(new CustomEvent('request-new-drain'))"
                    >
                        <md-icon slot="icon">add</md-icon>{" "}
                    </md-fab>
                </div>
            </div>
        </md-list>
        <md-list class="w-60 mt-4" id="drain-sidebar-list"></md-list>
    </div>
</div>

<script>
    import "@material/web/divider/divider.js";
    import "@material/web/fab/fab.js";
    import "@material/web/icon/icon.js";
    import "@material/web/list/list.js";
    import "@material/web/list/list-item.js";
    import "@/components/new-drain-dialog";
    import "@/components/drain-sidebar-item";

    import { populateDrains, $drains } from "@/helpers/drains";
    import { encryptString } from "@/services/crypto";
    import { db } from "@/services/db";
    import { setVaultKey } from "@/services/vault";
    import { ulid } from "ulid";
    import { $identity, getStoredIdentityClient } from "@/services/identity";

    $identity.set(getStoredIdentityClient());
    // This populates the $drains nanostore
    const drainListEl = document.getElementById("drain-sidebar-list");
    if (!drainListEl) throw new Error("Sidebar not found");

    $drains.listen((drains) => {
        if (!drains) return;
        // Use `=` (not `+=`) so this replaces the list on every update
        // instead of appending duplicates each time $drains changes.
        // Each item needs an explicit closing tag — custom elements
        // don't support the self-closing `/>` shorthand in HTML, so
        // `<drain-sidebar-item />` would actually nest the next item
        // inside the previous one instead of rendering siblings.
        drainListEl.innerHTML = ""; // Clear previous items

        drains.forEach((drain: any) => {
            const item = document.createElement("drain-sidebar-item");

            // By using setAttribute, the browser handles string escaping for you
            item.setAttribute("data-drain", JSON.stringify(drain));

            drainListEl.appendChild(item);
        });
    });
    await populateDrains();
    window.addEventListener("drain-created", async (e) => {
        // @ts-ignore
        const { visibility, title, key } = e.detail;
        const id = `notebook:${ulid()}`;
        let titleCipher = null;
        let finalTitle = title;

        if (visibility === "private") {
            if (key) {
                const { importNotebookKey } =
                    await import("@/services/crypto.js");
                const cryptoKey = await importNotebookKey(key);
                titleCipher = await encryptString(cryptoKey, title);
                finalTitle = null;
                setVaultKey(id, key);
            }
        }
        console.log($identity.get());
        const doc = {
            _id: id,
            type: "notebook",
            visibility,
            title: finalTitle,
            titleCipher,
            createdBy: $identity.get().publicUserId,
            createdAt: Date.now(),
        };

        await db.put(doc);
        await populateDrains();
    });
</script>
<div>
    <new-drain-dialog></new-drain-dialog>
</div>
