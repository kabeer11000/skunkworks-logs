<div class="w-screen h-screen flex items-center justify-center">
    <md-dialog id="onboarding-dialog" open type="alert">
        <h2 slot="headline">Create Account</h2>
        <form slot="content" id="onboarding-form" method="dialog">
            <p>
                Welcome to SkunkWorks Logs! Enter your name and email to get
                started. This identifies your entries across devices.
            </p>
            <div
                style="display: flex; flex-direction: column; gap: 16px; padding-top: 8px; width: 320px;"
            >
                <md-outlined-text-field
                    name="userName"
                    label="Full Name"
                    required
                >
                </md-outlined-text-field>
                <md-outlined-text-field
                    name="userEmail"
                    label="Email Address"
                    type="email"
                    required
                >
                </md-outlined-text-field>
            </div>
        </form>

        <div slot="actions">
            <md-filled-button
                form="onboarding-form"
                class="w-full mt-4"
                type="submit"
                value="submit">Sign Up</md-filled-button
            >
        </div>
    </md-dialog>
    <script>
        import {
            $identity,
            deriveIdentity,
            saveIdentityClient,
        } from "@/services/identity";
        import { db } from "@/services/db";

        const form = document.getElementById(
            "onboarding-form",
        ) as HTMLFormElement | null;
        if (!form) throw new Error("Onboarding form not found");
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            if (!formData.get("userEmail") || !formData.get("userName")) {
                alert("Please fill in all required fields.");
                return;
            }

            const identity = await deriveIdentity(
                formData.get("userEmail") as string,
                formData.get("userName") as string,
            );
            saveIdentityClient(identity);
            // This is the only place this nanostore is updated
            $identity.set(identity);

            const profileDoc = {
                _id: `profile:${identity.publicUserId}`,
                type: "profile",
                publicUserId: identity.publicUserId,
                name: identity.name,
                color: identity.color,
                createdAt: Date.now(),
            };

            try {
                await db.put(profileDoc);
                window.location.reload();
            } catch (err) {
                // @ts-ignore
                if (err.status !== 409) throw err;
            }
        });
    </script>
</div>
