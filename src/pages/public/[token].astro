---
import Layout from "@/layouts/Layout.astro";
import { getDrainByPublicToken, getAdminDoc, getPublicEntries } from "@/lib/couchdb-admin";

export const prerender = false;

const token = Astro.params.token as string;
const resolved = await getDrainByPublicToken(token);

let notebook: any = null;
let entries: any[] = [];
if (resolved) {
	notebook = await getAdminDoc(resolved.dbName, "notebook");
	entries = await getPublicEntries(resolved.dbName);
}

function safeColor(val: unknown) {
	return typeof val === "string" && val.trim() ? val : "#999";
}
---

<Layout>
	<div class="mx-auto flex h-full min-h-0 w-full max-w-2xl flex-col overflow-y-auto px-4 py-10">
		{!resolved ? (
			<p class="text-center text-sm text-muted-foreground">This link is no longer valid.</p>
		) : (
			<>
				<h1 class="mb-1 text-xl font-semibold">{notebook?.title || "Untitled"}</h1>
				{notebook?.description && (
					<p class="mb-8 text-sm text-muted-foreground">{notebook.description}</p>
				)}
				{entries.length === 0 && (
					<p class="text-sm text-muted-foreground">No entries yet.</p>
				)}
				{entries.map((entry) => (
					<p
						class="mb-1.5 rounded-lg p-3"
						style={`background-color: color-mix(in srgb, ${safeColor(entry.updatedByColor)} 12%, var(--background))`}
						set:html={entry.content}
					/>
				))}
			</>
		)}
	</div>
</Layout>
