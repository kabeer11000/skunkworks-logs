---
import LandingLayout from '@/components/LandingLayout.astro'
---

<LandingLayout>
  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-50 flex h-16 items-center justify-between border-b bg-background/80 px-8 backdrop-blur-sm">
    <div class="flex items-center gap-2.5">
      <img src="/logo/skunkworks-transparent.png" class="h-7 w-7" alt="" />
      <span class="text-sm font-semibold tracking-tight">SkunkWorks / Logs</span>
    </div>
    <div class="flex items-center gap-6">
      <a href="/#features" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Features</a>
      <a href="/#how" class="text-sm text-muted-foreground hover:text-foreground transition-colors">How it works</a>
      <a
        href="/drains"
        class="rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-80"
      >
        Open app
      </a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="flex min-h-screen flex-col items-center justify-center px-6 pt-16 text-center">
    <div class="max-w-2xl">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs text-muted-foreground">
        <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
        Offline-first. Syncs when online.
      </div>

      <h1 class="text-5xl font-extrabold tracking-tight leading-[1.1]">
        Your engineering<br />log, finally.
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-muted-foreground max-w-md mx-auto">
        A personal drain for every release, incident, and decision.
        Entries sync across devices. Private drains are encrypted.
        No account required.
      </p>

      <div class="mt-10 flex items-center justify-center gap-4">
        <a
          href="/drains"
          class="rounded-xl bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-80"
        >
          Start logging
        </a>
        <a
          href="/#features"
          class="rounded-xl border px-6 py-3 text-sm font-medium transition-colors hover:bg-muted"
        >
          Learn more
        </a>
      </div>
    </div>

    <!-- Preview card mockup -->
    <div class="mt-16 w-full max-w-3xl">
      <div class="rounded-2xl border bg-background shadow-xl shadow-black/30 overflow-hidden">
        <div class="flex items-center gap-2 border-b px-4 py-3 bg-muted/30">
          <div class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-muted-foreground/30"></div>
        </div>
        <div class="p-6 space-y-3">
          <div class="flex items-center gap-3">
            <div class="h-6 w-6 rounded-full bg-[#7c6af7] opacity-60"></div>
            <div class="h-3 w-32 rounded bg-muted-foreground/20"></div>
          </div>
          <div class="rounded-lg border p-3 pl-4">
            <div class="h-3 w-3/4 rounded bg-muted-foreground/20 mb-2"></div>
            <div class="h-3 w-1/2 rounded bg-muted-foreground/10"></div>
          </div>
          <div class="flex items-center gap-3">
            <div class="h-6 w-6 rounded-full bg-[#f77c6a] opacity-60"></div>
            <div class="h-3 w-24 rounded bg-muted-foreground/20"></div>
          </div>
          <div class="rounded-lg border p-3 pl-4">
            <div class="h-3 w-full rounded bg-muted-foreground/20 mb-1.5"></div>
            <div class="h-3 w-2/3 rounded bg-muted-foreground/10 mb-1.5"></div>
            <div class="h-3 w-1/2 rounded bg-muted-foreground/10"></div>
          </div>
          <div class="flex items-center gap-3">
            <div class="h-6 w-6 rounded-full bg-[#6ac7f7] opacity-60"></div>
            <div class="h-3 w-28 rounded bg-muted-foreground/20"></div>
          </div>
          <div class="rounded-lg border p-3 pl-4">
            <div class="h-3 w-4/5 rounded bg-muted-foreground/20 mb-1.5"></div>
            <div class="h-3 w-2/3 rounded bg-muted-foreground/10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Features</p>
      <h2 class="text-3xl font-bold tracking-tight">Everything you need, nothing you don't.</h2>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">End-to-end encrypted</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Private drains are AES-256 encrypted. Your data is visible only to you — even the sync server can't read it.
          </p>
        </div>

        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">Works offline</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Full functionality without internet. Changes sync automatically when you're back online — no manual uploads.
          </p>
        </div>

        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">No account needed</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            No sign-up forms. Your email identifies you across devices. Start logging in seconds.
          </p>
        </div>

        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">Live sync</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Changes appear in real time across all your devices. PouchDB handles conflict resolution automatically.
          </p>
        </div>

        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="M3 9h18M9 21V9"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">Notion-style entries</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Each line is an independent block. Edit in place, see author and timestamp on hover. Clean and focused.
          </p>
        </div>

        <div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl border bg-muted">
            <svg class="size-5 text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
              <line x1="4" y1="22" x2="4" y2="15"/>
            </svg>
          </div>
          <h3 class="mb-2 font-semibold">Drains everywhere</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Create as many drains as you want — one per project, service, or team. Share or keep private.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="border-y bg-muted/30 px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">How it works</p>
      <h2 class="text-3xl font-bold tracking-tight">Three steps to a better log.</h2>

      <div class="mt-12 space-y-12">
        <div class="flex gap-8 items-start">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border bg-background font-semibold text-sm">1</div>
          <div>
            <h3 class="mb-1 font-semibold">Create an identity</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Enter your name and email. Your email becomes your identity — a deterministic color and ID that follows you across every device. No password, no verification.
            </p>
          </div>
        </div>

        <div class="flex gap-8 items-start">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border bg-background font-semibold text-sm">2</div>
          <div>
            <h3 class="mb-1 font-semibold">Open or create a drain</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Drains are your log channels. Create as many as you need. Each drain gets a shareable link — useful for sharing with teammates on shared drains, or keeping it private.
            </p>
          </div>
        </div>

        <div class="flex gap-8 items-start">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border bg-background font-semibold text-sm">3</div>
          <div>
            <h3 class="mb-1 font-semibold">Start typing</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Every paragraph is an independent entry. Click and type — autosave handles the rest. No submit button. No manual saves. Your entries appear instantly on all devices.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-24 text-center">
    <div class="mx-auto max-w-xl">
      <h2 class="text-3xl font-bold tracking-tight">Stop losing context.</h2>
      <p class="mt-4 text-muted-foreground leading-relaxed">
        Your next incident review will thank you. Start logging in seconds — no account, no setup, no commitment.
      </p>
      <div class="mt-8">
        <a
          href="/drains"
          class="inline-flex items-center gap-2 rounded-xl bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-80"
        >
          Open SkunkWorks Logs
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t px-6 py-8">
    <div class="mx-auto max-w-4xl flex items-center justify-between">
      <div class="flex items-center gap-2">
        <img src="/logo/skunkworks-transparent.png" class="h-5 w-5" alt="" />
        <span class="text-sm font-medium">SkunkWorks Logs</span>
      </div>
      <p class="text-xs text-muted-foreground">
        Built for engineers who ship.
      </p>
    </div>
  </footer>
</LandingLayout>
