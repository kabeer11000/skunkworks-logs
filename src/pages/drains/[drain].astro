---
import Feed from "@/components/Feed";
import PageShell from "@/components/PageShell";
import Onboarding from "@/components/Onboarding";
import Layout from "@/layouts/Layout.astro";

const cookie = Astro.cookies.get('sk_identity');
const identity = cookie ? cookie.json() : null;
const drainId = `notebook:${Astro.params.drain}`;
---

<Layout>
	<script>
		import { startSync } from '@/services/sync';

		const dot = document.getElementById('sync-dot');
		const label = document.getElementById('sync-label');

		startSync((status) => {
			if (!dot || !label) return;
			if (status === 'active') {
				dot.className = 'w-2 h-2 rounded-full bg-green-400';
				label.textContent = 'synced';
			} else if (status === 'paused') {
				dot.className = 'w-2 h-2 rounded-full bg-yellow-400';
				label.textContent = 'paused';
			} else {
				dot.className = 'w-2 h-2 rounded-full bg-red-400';
				label.textContent = 'error';
			}
		});
	</script>
	{identity ? (
		<PageShell client:load>
			<div class="relative mx-auto min-h-0 w-full max-w-4xl flex-1">
				<div id="sync-indicator" class="fixed top-4 right-6 z-50 flex items-center gap-2 rounded-full border bg-background/80 px-3 py-1.5 text-xs text-muted-foreground backdrop-blur-sm">
					<span id="sync-dot" class="w-2 h-2 rounded-full bg-yellow-400"></span>
					<span id="sync-label">connecting</span>
				</div>
				<Feed notebookId={drainId} client:only="react" />
			</div>
		</PageShell>
	) : (
		<Onboarding client:load />
	)}
</Layout>
